{
  "name": "dsh-codex-plus",
  "version": "0.1.5",
  "description": "Codex（ChatGPT Plus/Pro）订阅接入 DSH：侧边栏展示 5 小时与一周窗口额度、重置时间与重置券数量并支持选择具体重置券，读取额度时自动把订阅模型接进模型选择器，access token 到期前自动续期。Codex (ChatGPT Plus/Pro) subscription for DSH: quota panel with explicit reset-credit selection, automatic subscription routing, and token upkeep.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "codex",
    "chatgpt",
    "quota",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mia-wong1016/dsh-codex-plus.git"
  },
  "homepage": "https://github.com/mia-wong1016/dsh-codex-plus#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/unit.mjs",
    "smoke": "node test/smoke.mjs",
    "smoke:run": "node test/smoke.mjs --run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  }
}
